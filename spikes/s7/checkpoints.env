# Checkpoints hashed by spike S7: public Hugging Face repo ids and the revisions the staged
# files came from. The *_REL paths are relative to $HF_HUB_CACHE, a Hugging Face cache hub
# directory; the revision is the snapshot directory name in that cache (also the content of
# the cache's refs/main for each repo).
CKPT_LABELS="gemma deepseek"

CKPT_gemma_REPO="RedHatAI/gemma-4-31B-it-FP8-block"
CKPT_gemma_REV="d7242548c457ab4b45bd3adb8937f2659af4739d"
CKPT_gemma_REL="models--RedHatAI--gemma-4-31B-it-FP8-block/snapshots/d7242548c457ab4b45bd3adb8937f2659af4739d"

CKPT_deepseek_REPO="deepseek-ai/DeepSeek-V4-Flash-0731"
CKPT_deepseek_REV="7872f01b1d1fe23eabc4c98b48bffcef5a386062"
CKPT_deepseek_REL="models--deepseek-ai--DeepSeek-V4-Flash-0731/snapshots/7872f01b1d1fe23eabc4c98b48bffcef5a386062"

# Single-stream read-size sweep: three shards of a third checkpoint that no other phase reads.
SWEEP_REPO="Qwen/Qwen3-Coder-30B-A3B-Instruct"
SWEEP_REV="b2cff646eb4bb1d68355c01b18ae02e7cf42d120"
SWEEP_REL="models--Qwen--Qwen3-Coder-30B-A3B-Instruct/snapshots/b2cff646eb4bb1d68355c01b18ae02e7cf42d120"
SWEEP_SHARD_1M="model-00001-of-00016.safetensors"
SWEEP_SHARD_8M="model-00002-of-00016.safetensors"
SWEEP_SHARD_64M="model-00003-of-00016.safetensors"
SWEEP_SHARD_WARM="model-00004-of-00016.safetensors"
